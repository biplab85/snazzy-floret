<!-- ============ BLOG / JOURNAL ============ -->
<section class="sf-section sf-blog-section">
	<!-- Animated Black Gradient Background -->
	<div class="sf-blog-bg" aria-hidden="true">
		<div class="sf-blog-bg__base"></div>
		<div class="sf-blog-bg__orb sf-blog-bg__orb--1"></div>
		<div class="sf-blog-bg__orb sf-blog-bg__orb--2"></div>
		<div class="sf-blog-bg__orb sf-blog-bg__orb--3"></div>
		<div class="sf-blog-bg__shimmer"></div>
		<div class="sf-blog-bg__grain"></div>
	</div>
	<div class="sf-container" style="position:relative;z-index:2;">
		<div class="sf-blog__grid">
			<?php
			$blog_posts = new WP_Query( array(
				'post_type'      => 'post',
				'posts_per_page' => 3,
				'post_status'    => 'publish',
			) );
			$post_index = 0;
			if ( $blog_posts->have_posts() ) :
				while ( $blog_posts->have_posts() ) : $blog_posts->the_post();
				$post_index++;

				// After first card, inject the section header
				if ( 2 === $post_index ) : ?>
					<!-- Section Header (placed above the 2 smaller cards) -->
					<div class="sf-blog__header sf-reveal">
						<div class="leftAsside">
							<span class="sf-section__tag sf-section__tag--light"><?php esc_html_e( 'Journal', 'snazzy-floret' ); ?></span>
							<h2 class="sf-section__title sf-blog__section-title"><?php esc_html_e( 'From Our Blog', 'snazzy-floret' ); ?></h2>
							<p class="sf-blog__section-desc"><?php esc_html_e( 'Stories, tips, and inspiration from the world of fashion', 'snazzy-floret' ); ?></p>
						</div>
						<a href="<?php echo esc_url( home_url( '/blog/' ) ); ?>" class="sf-btn sf-btn--outline-light">
							<?php esc_html_e( 'Read all', 'snazzy-floret' ); ?>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
						</a>
					</div>
				<?php endif; ?>

			<article class="sf-blog-card sf-reveal">
				<a href="<?php the_permalink(); ?>" class="sf-blog-card__image-wrap">
					<?php if ( has_post_thumbnail() ) : ?>
						<?php the_post_thumbnail( 'medium_large', array( 'class' => 'sf-blog-card__img' ) ); ?>
					<?php else : ?>
						<div class="sf-blog-card__img-placeholder">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
						</div>
					<?php endif; ?>
				</a>
				<div class="sf-blog-card__content">
					<time class="sf-blog-card__date" datetime="<?php echo esc_attr( get_the_date( 'c' ) ); ?>"><?php echo esc_html( get_the_date( 'M d, Y' ) ); ?></time>
					<h3 class="sf-blog-card__title">
						<a href="<?php the_permalink(); ?>"><?php the_title(); ?></a>
					</h3>
					<p class="sf-blog-card__excerpt"><?php echo esc_html( wp_trim_words( get_the_excerpt(), 15 ) ); ?></p>
					<a href="<?php the_permalink(); ?>" class="sf-blog-card__link">
						<?php esc_html_e( 'Read more', 'snazzy-floret' ); ?>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</a>
				</div>
			</article>
			<?php
				endwhile;
				wp_reset_postdata();
			endif;
			?>
		</div>
	</div>
</section>

<main class="sf-main">
