<script>
(function () {
	var hero = document.querySelector('.sf-philosophy__hero');
	if (!hero) { return; }
	var pool;
	try { pool = JSON.parse(hero.getAttribute('data-sf-photo-pool') || '[]'); }
	catch (e) { return; }
	if (!Array.isArray(pool) || pool.length < 2) { return; }

	var slots = [1, 2, 3, 4].map(function (n) {
		return hero.querySelector('.sf-philosophy__photo--' + n);
	});
	if (slots.some(function (s) { return !s; })) { return; }

	var currentUrls = slots.map(function (slot) {
		var img = slot.querySelector('.sf-philosophy__photo-img');
		return img ? img.currentSrc || img.src : '';
	});

	var slotIndex = 0;  // which slot to change next (0..3)
	var poolCursor = 0; // rotating pointer into pool
	var FADE_MS = 900;
	var INTERVAL_MS = 30000;
	var timer = null;

	function pickNext(excludeUrls) {
		for (var i = 0; i < pool.length; i++) {
			var candidate = pool[(poolCursor + i) % pool.length];
			if (excludeUrls.indexOf(candidate) === -1) {
				poolCursor = (poolCursor + i + 1) % pool.length;
				return candidate;
			}
		}
		var fallback = pool[poolCursor % pool.length];
		poolCursor = (poolCursor + 1) % pool.length;
		return fallback;
	}

	function crossfade(slot, newUrl, slotIdx) {
		var oldImg = slot.querySelector('.sf-philosophy__photo-img');
		if (!oldImg) { return; }

		var newImg = oldImg.cloneNode(false);
		newImg.removeAttribute('srcset');
		newImg.removeAttribute('sizes');
		newImg.removeAttribute('loading');
		newImg.src = newUrl;
		newImg.style.position = 'absolute';
		newImg.style.inset = '0';
		newImg.style.width = '100%';
		newImg.style.height = '100%';
		newImg.style.opacity = '0';
		newImg.style.transition = 'opacity ' + FADE_MS + 'ms ease';
		newImg.style.zIndex = '2';

		function run() {
			slot.appendChild(newImg);
			// force reflow so transition kicks in
			void newImg.offsetWidth;
			newImg.style.opacity = '1';
			setTimeout(function () {
				if (oldImg && oldImg.parentNode) { oldImg.parentNode.removeChild(oldImg); }
				newImg.style.position = '';
				newImg.style.inset = '';
				newImg.style.width = '';
				newImg.style.height = '';
				newImg.style.transition = '';
				newImg.style.opacity = '';
				newImg.style.zIndex = '';
				currentUrls[slotIdx] = newUrl;
			}, FADE_MS + 60);
		}

		if (newImg.complete && newImg.naturalWidth > 0) {
			run();
		} else {
			newImg.addEventListener('load', run, { once: true });
			newImg.addEventListener('error', function () {
				if (newImg.parentNode) { newImg.parentNode.removeChild(newImg); }
			}, { once: true });
		}
	}

	function cycle() {
		var slot = slots[slotIndex];
		if (!slot) { return; }
		var newUrl = pickNext(currentUrls);
		if (!newUrl || newUrl === currentUrls[slotIndex]) {
			slotIndex = (slotIndex + 1) % 4;
			return;
		}
		crossfade(slot, newUrl, slotIndex);
		slotIndex = (slotIndex + 1) % 4;
	}

	function start() {
		if (timer) { return; }
		timer = setInterval(cycle, INTERVAL_MS);
	}
	function stop() {
		if (timer) { clearInterval(timer); timer = null; }
	}

	start();
	document.addEventListener('visibilitychange', function () {
		if (document.hidden) { stop(); } else { start(); }
	});
})();
</script>

