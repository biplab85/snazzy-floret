				__( 'Editor\'s Pick', 'snazzy-floret' ),
				__( 'Best Seller', 'snazzy-floret' ),
				__( 'New Season', 'snazzy-floret' ),
			);

			$cat_features = array(
				array( __( 'Free Shipping', 'snazzy-floret' ), __( 'Custom Sizing', 'snazzy-floret' ), __( 'Premium Fabric', 'snazzy-floret' ) ),
				array( __( 'Handcrafted', 'snazzy-floret' ), __( 'Comfort Fit', 'snazzy-floret' ), __( 'All Seasons', 'snazzy-floret' ) ),
				array( __( 'Limited Edition', 'snazzy-floret' ), __( 'Eco-Friendly', 'snazzy-floret' ), __( 'Easy Care', 'snazzy-floret' ) ),
				array( __( 'Size Inclusive', 'snazzy-floret' ), __( 'Quick Delivery', 'snazzy-floret' ), __( 'Gift Ready', 'snazzy-floret' ) ),
				array( __( 'Family Matching', 'snazzy-floret' ), __( 'Festive Ready', 'snazzy-floret' ), __( 'Top Rated', 'snazzy-floret' ) ),
			);

			if ( ! empty( $categories ) && ! is_wp_error( $categories ) ) :
				$cat_index = 0;
				foreach ( $categories as $cat ) :
					$thumb_id = get_term_meta( $cat->term_id, 'thumbnail_id', true );
					$cat_link = get_term_link( $cat );

					if ( ! $thumb_id ) {
						$cat_products = wc_get_products( array(
							'category' => array( $cat->slug ),
							'limit'    => 1,
							'status'   => 'publish',
							'orderby'  => 'date',
							'order'    => 'DESC',
						) );
						if ( ! empty( $cat_products ) ) {
							$thumb_id = $cat_products[0]->get_image_id();
						}
					}

					$icon     = $cat_icons[ $cat_index % count( $cat_icons ) ];
					$desc     = $cat_descriptions[ $cat_index % count( $cat_descriptions ) ];
					$tagline  = $cat_taglines[ $cat_index % count( $cat_taglines ) ];
					$features = $cat_features[ $cat_index % count( $cat_features ) ];
			?>
				<a href="<?php echo esc_url( $cat_link ); ?>" class="sf-category-card sf-reveal" style="--card-index: <?php echo esc_attr( $cat_index ); ?>;">
					<div class="sf-category-card__img-wrap">
						<?php if ( $thumb_id ) : ?>
							<?php echo wp_get_attachment_image( $thumb_id, 'sf-category-thumb', false, array(
								'class'   => 'sf-category-card__img',
								'loading' => 'lazy',
								'alt'     => esc_attr( $cat->name ),
							) ); ?>
						<?php else : ?>
							<div class="sf-category-card__placeholder">
								<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
							</div>
						<?php endif; ?>
					</div>
					<span class="sf-category-card__number" aria-hidden="true"><?php echo esc_html( $cat_index + 1 ); ?></span>
					<div class="sf-category-card__overlay">
						<span class="sf-category-card__tagline"><?php echo esc_html( $tagline ); ?></span>
						<div class="sf-category-card__icon-badge">
							<?php echo $icon; // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped -- Static SVG ?>
						</div>
						<span class="sf-category-card__name"><?php echo esc_html( $cat->name ); ?></span>
						<p class="sf-category-card__desc"><?php echo esc_html( $desc ); ?></p>
						<div class="sf-category-card__features">
							<?php foreach ( $features as $feat ) : ?>
								<span class="sf-category-card__feat">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
									<?php echo esc_html( $feat ); ?>
								</span>
							<?php endforeach; ?>
						</div>
						<div class="sf-category-card__meta">
							<span class="sf-category-card__count">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
								<?php echo esc_html( $cat->count ); ?> <?php esc_html_e( 'Products', 'snazzy-floret' ); ?>
							</span>
							<span class="sf-category-card__arrow">
								<span class="sf-category-card__arrow-text"><?php esc_html_e( 'Explore', 'snazzy-floret' ); ?></span>
